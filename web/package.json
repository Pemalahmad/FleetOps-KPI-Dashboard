{
  "name": "fleetops-kpi-web",
  "version": "0.5.0",
  "private": true,
  "scripts": {
    "copy-assets": "node scripts/copy-assets.mjs && node scripts/copy-content.mjs",
    "predev": "npm run copy-assets",
    "dev": "next dev",
    "prebuild": "npm run copy-assets",
    "build": "next build && node scripts/postbuild.mjs",
    "start": "npx serve out",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "demo-preview": "npm run build && node scripts/demo-preview.mjs && npm run build",
    "gifs": "node scripts/capture-gifs.mjs",
    "ship-check": "node scripts/ship-check.mjs",
    "lint-skills": "node scripts/lint-skills.mjs",
    "papercut": "node scripts/log-papercut.mjs"
  },
  "dependencies": {
    "@duckdb/duckdb-wasm": "^1.33.1-dev57.0",
    "@number-flow/react": "^0.6.2",
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "echarts": "^6.1.0",
    "geist": "1.8.2",
    "katex": "^0.19.1",
    "marked": "^18.2.1",
    "motion": "14.9.0",
    "next": "16.4.6",
    "pdfjs-dist": "^6.5.438",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tesseract.js": "^7.0.0",
    "three": "0.187.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@tailwindcss/turbopack": "4.3.5",
    "@tesseract.js-data/ara": "^1.0.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "@types/katex": "^0.16.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "0.187.0",
    "eslint": "^10.15.0",
    "eslint-config-next": "16.4.6",
    "fake-indexeddb": "6.2.8",
    "fast-check": "4.10.2",
    "tailwindcss": "4.3.5",
    "typescript": "^5",
    "vitest": "^5.1.0"
  },
  "license": "FSL-1.1-MIT"
}
